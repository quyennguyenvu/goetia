{
  // Prose is never hard-wrapped: one line per paragraph or bullet, however
  // long (MD013 off — user rule; every tracked doc reflowed 2026-08-11).
  // No "globs" on purpose — pass files explicitly.
  "config": {
    "default": true,
    "MD013": false,
    // The README is a showcase: centered banner, theme-aware screenshots via
    // <picture>, folded troubleshooting. Nothing wider than this list.
    // h1 is here so the page can open with the banner and still satisfy
    // MD041 — an HTML <h1> counts as the required top-level heading.
    "MD033": {
      "allowed_elements": [
        "a",
        "h1",
        "img",
        "picture",
        "source",
        "p",
        "div",
        "details",
        "summary",
        "kbd",
        "br"
      ]
    }
  }
}
